{
  "name": "rytm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev --port 8788",
    "build": "tsc --noEmit && tsc --noEmit -p functions && vite build",
    "preview": "vite preview",
    "import:products": "node scripts/import-products.mjs",
    "import:meals": "node scripts/import-meals.mjs",
    "import:meal-plans": "node scripts/import-meal-plans.mjs",
    "db:migrate:local": "wrangler d1 migrations apply rytm-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply rytm-db --remote"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261031.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.156.0"
  }
}
